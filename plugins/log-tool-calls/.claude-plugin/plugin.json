{
  "name": "log-tool-calls",
  "description": "A PreToolUse hook that logs every tool invocation to logs/hooks.log",
  "version": "1.1.0",
  "author": {
    "name": "eighttrigrams"
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/hooks/log-tools.sh"
          }
        ]
      }
    ]
  }
}
