{
  "name": "git-identity",
  "description": "A PreToolUse hook that stamps the agent's git identity onto any Bash call that commits",
  "version": "1.0.0",
  "author": {
    "name": "eighttrigrams"
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/hooks/git-identity.sh"
          }
        ]
      }
    ]
  }
}
